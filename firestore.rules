rules_version = '2';

// Model přístupu: dokument domácnosti se jmenuje párovacím kódem a ten kód je
// zároveň jediné tajemství (capability model, docs/SPEC.md kap. 7). Kdo kód
// zná, do domácnosti patří; kdo ho nezná, dokument nenajde, protože výpis
// kolekce je zakázaný a kód má 10 znaků Crockford Base32.
service cloud.firestore {
  // Správce přehledu o používání.
  //
  // Nestačí být přihlášený: musí jít o účet s tímhle e-mailem, přihlášený
  // heslem. Anonymní účet, kterým jezdí aplikace pro rodiče, sem nedosáhne,
  // protože e-mail vůbec nemá. Účet se zakládá ručně ve Firebase konzoli
  // (Authentication, poskytovatel Email/Password) a heslo k němu je jediné,
  // co výpis chrání. Postup je v docs/FIREBASE.md.
  //
  // Ověřenou adresu pravidlo nevyžaduje. Účet založený v konzoli je
  // neověřený a konzole ověřovací e-mail poslat neumí, takže by ta
  // podmínka jen znemožnila přihlášení. Adresu si stejně vybírá správce
  // projektu, ne přihlašující se člověk, takže se tím nic neotevírá.
  //
  // Od 24. 9. 2026 správce **nečte dokumenty domácností vůbec**, jen
  // kolekci `statistiky` s anonymními počty.
  function jsemSpravce() {
    return request.auth != null
      && request.auth.token.email == 'taronwho@gmail.com'
      && request.auth.token.firebase.sign_in_provider == 'password';
  }

  match /databases/{db}/documents {
    // Anonymní souhrny domácností pro přehled o používání.
    //
    // Každý telefon si ze své domácnosti spočítá jen čísla
    // (src/admin/prehled.ts) a zapíše je pod otiskem SHA-256 párovacího
    // kódu — ze statistik se tak kód ani domácnost dohledat nedají.
    // Pravidlo hlídá tvar: jen povolené klíče, čísla a mapy počtů
    // s omezenou velikostí, aby se sem nedal uložit volný text.
    match /statistiky/{otisk} {
      function jePocet(hodnota) {
        return hodnota is int && hodnota >= 0;
      }
      function maTvarSouhrnu() {
        let d = request.resource.data;
        return d.keys().hasOnly(['verze', 'schema', 'zarizeni', 'zarizeniPodleTypu', 'deti',
            'detiPodleFaze', 'ochutnavky', 'smazaneOchutnavky', 'oblibene',
            'poznamkyURecepu', 'suroviny', 'naposledy'])
          && d.keys().hasAll(['verze', 'schema', 'zarizeni', 'zarizeniPodleTypu', 'deti',
            'detiPodleFaze', 'ochutnavky', 'smazaneOchutnavky', 'oblibene',
            'poznamkyURecepu', 'suroviny', 'naposledy'])
          && jePocet(d.verze) && jePocet(d.schema) && jePocet(d.zarizeni)
          && jePocet(d.deti) && jePocet(d.ochutnavky) && jePocet(d.smazaneOchutnavky)
          && jePocet(d.oblibene) && jePocet(d.poznamkyURecepu) && jePocet(d.naposledy)
          && d.zarizeniPodleTypu is map && d.zarizeniPodleTypu.size() <= 20
          && d.detiPodleFaze is map && d.detiPodleFaze.size() <= 10
          && d.suroviny is map && d.suroviny.size() <= 50;
      }

      allow get, list: if jsemSpravce();
      allow create, update: if request.auth != null
        && otisk.matches('^[0-9a-f]{64}$')
        && maTvarSouhrnu();
      allow delete: if false;
    }

    match /households/{householdId} {
      function prihlaseny() {
        return request.auth != null;
      }
      function stavajiciClenove() {
        return resource.data.members;
      }
      function noviClenove() {
        return request.resource.data.members;
      }
      function jsemClen() {
        return prihlaseny() && request.auth.uid in stavajiciClenove();
      }

      // Tvar dokumentu. Bez téhle kontroly by šlo dokument přepsat čímkoli
      // a aplikace by na tom spadla ještě dřív, než by rodič něco viděl.
      function maTvar() {
        return request.resource.data.keys().hasAll(['state', 'updatedAt', 'members'])
          && request.resource.data.state is map
          && request.resource.data.updatedAt is number
          && request.resource.data.members is list;
      }

      // Připojující se telefon nesmí deník zkrátit.
      //
      // Smazaná ochutnávka zůstává v poli jako náhrobek (`deleted: true`),
      // takže poctivé sloučení počet záznamů nikdy nesníží. Kdo zná párovací
      // kód, se sice smí k domácnosti připojit, ale nesmí týmž zápisem
      // vymazat, co rodiče za měsíce nasbírali.
      //
      // Pozor na rozsah (audit 17. 9. 2026, nález 8.4): tahle podmínka je
      // součástí `pripojujiSe()`, ne `jsemClen()`. **Existující člen deník
      // zkrátit může.** Není to nedopatření, ale nutnost: `prevedStav()`
      // zahodí záznam, který neprojde kontrolou tvaru, a po takové opravě
      // je pole kratší. Kdyby platil zákaz i pro členy, jediný poškozený
      // záznam by domácnosti zablokoval všechny další zápisy a rodiče by
      // z hlášky nikdy nepřišli na proč.
      //
      // Člen je v tomhle modelu ten, kdo zná párovací kód — tedy někdo,
      // komu rodič kód sám dal. Jemu se důvěřuje stejně jako u mazání
      // dětí nebo receptových poznámek. Cizímu, kdo kód uhodne, ne: ten
      // prochází větví `pripojujiSe()`, kde podmínka platí.
      function nemazeDenik() {
        return request.resource.data.state.tastings.size()
          >= resource.data.state.tastings.size();
      }

      // Připojení dalšího telefonu k existující domácnosti.
      //
      // Bez tohohle by druhý rodič dokument přečetl, ale nikdy do něj nezapsal:
      // `jsemClen()` se ptá na seznam, ve kterém ještě není. Povoluje se proto
      // jediný krok — přidat sám sebe. Nikoho ubrat nejde a přidat jde jen
      // jeden uid, takže se přes tuhle větev nedá seznam členů přepsat.
      function pripojujiSe() {
        return prihlaseny()
          && request.auth.uid in noviClenove()
          && stavajiciClenove().toSet().difference(noviClenove().toSet()).size() == 0
          && noviClenove().size() == stavajiciClenove().size() + 1
          && nemazeDenik();
      }

      allow get: if prihlaseny();
      // Výpis domácností nesmí nikdo, ani správce (kontrola 24. 9. 2026).
      // Přehled o používání čte jen anonymní souhrny z `statistiky` níž.
      allow list: if false;
      allow create: if prihlaseny() && maTvar() && noviClenove() == [request.auth.uid];
      allow update: if maTvar()
        && noviClenove().size() <= 5
        && (jsemClen() || pripojujiSe());
      allow delete: if false;
    }
  }
}
