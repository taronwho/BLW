# Firebase web-konfigurace pro LOKÁLNÍ vývoj.
# Zkopíruj do .env.local (ten je v .gitignore) a vyplň hodnotami z Firebase konzole.
# Do repozitáře tyhle hodnoty NEPATŘÍ — v aplikaci je lze zadat v Nastavení
# a uloží se jen do prohlížeče.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
